server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  location /api/ {
    proxy_pass http://${AEGIS_API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location = /healthz { proxy_pass http://${AEGIS_API_UPSTREAM}; }
  location = /readyz { proxy_pass http://${AEGIS_API_UPSTREAM}; }
  location = /metrics { proxy_pass http://${AEGIS_API_UPSTREAM}; }

  # Runtime config generated at container start (docker-entrypoint.d/40-aegis-config.sh).
  location = /config.js { alias /tmp/config.js; add_header Cache-Control "no-store"; }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
