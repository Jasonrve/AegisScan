<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AegisScan.Operator</AssemblyName>
    <RootNamespace>AegisScan.Operator</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>CS1591;CA1848</NoWarn>
    <OperatorName>aegisscan</OperatorName>
    <GenerateOperatorResources>true</GenerateOperatorResources>
    <KubeOpsConfigOut>$(MSBuildProjectDirectory)\..\..\deploy\generated</KubeOpsConfigOut>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="KubeOps.Operator" Version="14.0.0" />
    <PackageReference Include="KubeOps.Generator" Version="13.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <!-- KubeOps CLI 13.2.0 loads the compiled assembly during CRD generation. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
  </ItemGroup>
</Project>
