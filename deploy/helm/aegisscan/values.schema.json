{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {"type": "object", "required": ["repository", "tag"]},
    "serviceMonitor": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
    "postgresql": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
    "keycloak": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
    "web": {"type": "object", "properties": {"loginMode": {"enum": ["sso", "password", "both"]}}}
  },
  "additionalProperties": true
}
